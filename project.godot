; Tavern Duel — a tactile Godot card battle prototype
config_version=5

[application]
config/name="Codex Tavern Acceptance 20261106"
run/main_scene="res://main.tscn"
run/main_scene.renderer_benchmark="res://tests/windows_renderer_benchmark.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/bg_color.privacy_test=Color(0, 0, 0, 1)
boot_splash/show_image.privacy_test=false

[autoload]
PrivacyTestGuard="*res://scripts/privacy_test_guard.gd"
SoundManager="*res://scripts/sound_manager.gd"

[editor_plugins]
enabled=PackedStringArray("res://addons/raw_runtime_export/plugin.cfg")

[debug]
; Native Visual Profiler needs all nested viewport markers. Export templates
; do not have the editor feature, so shipping builds keep the engine default.
settings/profiler/max_timestamp_query_elements.editor=4096

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
rendering_device/fallback_to_opengl3=false
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=2

environment/defaults/default_clear_color=Color(0.055, 0.035, 0.026, 1)
environment/defaults/default_clear_color.privacy_test=Color(0, 0, 0, 1)

[audio]
default_bus_layout="res://default_bus_layout.tres"

[input_devices]
pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[render_quality]
offscreen_max_scale=1.6

[native_mobile]
source_camera_enabled=true
source_consumers_verified=true

[native_ui]
; One source scene/layout for desktop and mobile; actual input stays platform-specific.
shared_source_ui=true

[native_rope]
enabled=true
audio_output_enabled=true
