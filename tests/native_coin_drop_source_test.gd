extends SceneTree
func _init():call_deferred("run")
func run():
	var player=load("res://scripts/native_coin_player.gd").new();root.add_child(player);player.setup();player.place_at_source_bone();player.play_drop(true,false)
	var audit=player.drop_source_audit()
	assert(audit.requests.is_empty())
	assert(audit.rejected_bindings.size()==1)
	assert(audit.rejected_bindings[0].path=="FX_SparksSuckin")
	assert(audit.rejected_bindings[0].class_id==88)
	assert(not audit.rejected_bindings[0].remapped_to_new)
	assert(audit.legacy_bindings[0].values==[0.0,0.0])
	player.sample_clip("MulliganCoinDrop2_Edit",3.86)
	assert(player.drop_source_audit().requests.is_empty())
	player.sample_clip("MulliganCoinDrop2_Edit",3.866666555404663)
	audit=player.drop_source_audit();assert(audit.requests.size()==2)
	for request in audit.requests:
		assert(request.event=="play_on_awake");assert(request.status=="blocked_source_ports_disabled");assert(not request.rendered)
	assert(audit.requests[0].emitter=="FX_CoinBurst1_new" and audit.requests[1].emitter=="FX_CoinBurst1_center")
	player.sample_clip("MulliganCoinDrop2_Edit",4.2);assert(player.drop_source_audit().requests.size()==2)
	player.sample_clip("MulliganCoinDrop2_Edit",6.0)
	audit=player.drop_source_audit();assert(audit.requests.size()==4)
	assert(audit.requests[2].event=="deactivate" and audit.requests[3].event=="deactivate")
	player.finish_coin_object();assert(player.drop_source_audit().finished)
	assert(player.drop_source_audit().rendered_drop_emitters==0)
	print("NATIVE_COIN_DROP_SOURCE_PASS old class88 zero-valued missing sparks remains inert; parent+child original activation3.866666555/deactivation6; source port explicitly disabled, no fabricated plume")
	player.queue_free();await process_frame;quit()
