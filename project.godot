; Tavern Duel — a tactile Godot card battle prototype
config_version=5

[application]
config/name="Codex Tavern Acceptance 20261106"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]
SoundManager="*res://scripts/sound_manager.gd"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=2

environment/defaults/default_clear_color=Color(0.055, 0.035, 0.026, 1)

[audio]
default_bus_layout="res://default_bus_layout.tres"

[input_devices]
pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[render_quality]
offscreen_max_scale=1.6
offscreen_max_scale.android=1.0
spatial_msaa_3d=2
spatial_msaa_3d.android=1
defer_highlight_surface_reads=false
defer_highlight_surface_reads.android=true
defer_highlight_surface_reads.macos=true
victory_trail_density=1.0
victory_trail_density.android=0.25
android_fx_fireball_capture="direct"
android_fx_coin_capture="direct"
android_fx_skip_captured_particle_solver=true
android_skip_hero_death_fireworks=true
android_hero_shader_warmup=true
macos_hero_shader_warmup=true
macos_spell_shader_warmup=true
macos_played_coin_warmup=true
macos_opponent_hellfire_warmup=true
macos_opponent_corruption_warmup=true
macos_life_tap_warmup=true
macos_native_board_particles=true
macos_board_projection_snapshot=true
macos_opening_coin_warmup=true
macos_turn_banner_warmup=true
macos_opening_deal_warmup=true
macos_history_shader_warmup=true
macos_hero_thaw_warmup=true
macos_result_warmup=true
terminal_background_lite=false
terminal_background_lite.android=true

[native_mobile]
source_camera_enabled=true
source_consumers_verified=true

[native_rope]
enabled=true
audio_output_enabled=true
