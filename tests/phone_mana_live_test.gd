extends SceneTree
const Live=preload("res://scripts/native_phone_mana_live.gd")
func _initialize():call_deferred("run")
func run():
 var renderer=load("res://scripts/native_card_renderer.gd").new();root.add_child(renderer)
 var mana=load("res://scripts/native_phone_mana_renderer.gd").new();root.add_child(mana);mana.setup(renderer)
 var live=Live.new();mana.add_child(live);live.setup(mana.assets,false,true)
 assert(live.blockers.is_empty(),str(live.blockers))
 assert(Live.transition_name(0,1,false)=="ManaGemUsed")
 assert(Live.transition_name(0,2,true)=="ManaGemProposed_Temp")
 assert(is_equal_approx(mana.assets.clip_length("ManaGemUsed"),0.5))
 var primed=Live.new();mana.add_child(primed);primed.setup(mana.assets,false,true)
 assert(primed.prime_state(1) and primed.visible_state==1 and not primed.playing)
 assert(primed.state.renderers[Live.GEM].get_surface_override_material(0).get_shader_parameter("fade_rgb").is_equal_approx(Vector3.ONE*0.4627451002597809))
 primed.queue_free()
 live.request_state(1);live.advance(0.1);print("MANA_LIVE ",live.audit())
 assert(live.clip=="ManaGemUsed" and live.playing)
 live.request_state(0);assert(live.clip=="ManaGemUsed")
 live.advance(0.4);assert(live.clip=="ManaGem_Restore" and live.visible_state==1)
 live.advance(0.5);assert(live.visible_state==0 and not live.playing)
 var temp=Live.new();mana.add_child(temp);temp.setup(mana.assets,true,false);temp.create()
 temp.advance(0.5);assert(temp.playing and temp.clip=="ManaGemBirth_Temp")
 temp.request_state(3);assert(temp.destroy_started<0.0)
 temp.advance(1.5);print("TEMP_DESTROY ",temp.audit())
 assert(temp.destroy_started>=0.0 and temp.particle_players.size()==2)
 assert(temp.audio_results.size()==2 and temp.audio_results[0].accepted and temp.audio_results[1].accepted)
 assert(temp.audio_results[1].first_delay_sec==0.0)
 assert(temp.blockers.is_empty(),str(temp.blockers))
 temp.advance(1.0);assert(temp.finished and not temp.visible)
 var normal_birth=Live.new();mana.add_child(normal_birth);normal_birth.setup(mana.assets,false,false);normal_birth.create();normal_birth.advance(1.0)
 assert(normal_birth.blockers.is_empty(),str(normal_birth.blockers))
 assert(normal_birth.spawn_clip=="mana_spawn_edit" and normal_birth.spawn_state.renderers.size()>0)
 for record in mana.assets.objects.values():
  if record.type=="Material":assert(mana.assets.material(record.key) is ShaderMaterial,record.key)
 assert(mana.assets.strict_blockers.is_empty(),str(mana.assets.strict_blockers))
 var normal=Live.new();mana.add_child(normal);normal.setup(mana.assets,false,true)
 normal.request_state(3);normal.advance(0.25);assert(normal.destroy_action_started<0.0)
 normal.advance(0.25);print("NORMAL_DESTROY ",normal.audit())
 assert(normal.particle_players.size()==4 and normal.blockers.is_empty(),str(normal.blockers))
 normal.advance(1.0);assert(normal.finished)
 assert(normal.audio_results.size()==1 and normal.audio_results[0].accepted and is_equal_approx(normal.audio_results[0].first_delay_sec,0.5))
 var one=mana.begin_live(0,false,true,1);var two=mana.begin_live(1,true,true,0)
 assert(mana.remap_live({0:1,1:0}))
 assert(mana.live_crystals[1]==one and mana.live_crystals[0]==two)
 assert(one.visible_state==1 and not one.playing)
 assert(not mana.remap_live({0:1}))
 mana.set_live_state(0,3);assert(mana.retiring_crystals.size()==1 and not mana.live_crystals.has(0))
 mana.advance_live(1.0);assert(mana.retiring_crystals.is_empty())
 var layout=preload("res://scripts/source_phone_board_layout.gd")
 var interaction=layout.source_json(layout.INTERACTION_PATH)
 var bone=interaction.mana["ManaGemBone:7409025516337681387"]
 var q:Array=bone.local_rotation;var local=Transform3D(Basis(Quaternion(q[0],q[1],q[2],q[3])).scaled(layout.vector(bone.local_scale)),layout.vector(bone.local_position))
 var parent_pose=layout.matrix(bone.world_matrix)*local.affine_inverse();local.origin=Vector3.ZERO
 var hidden_pose=parent_pose*local
 var hidden=mana.begin_live(10,true,false,0,hidden_pose,true)
 assert(hidden!=null and mana.live_crystals.has(10) and not hidden.source_active)
 assert(not hidden.state.root.visible and not hidden.spawn_state.root.visible)
 assert(mana.pieces.crystal_10.root.transform.is_equal_approx(hidden_pose) and not mana.pieces.crystal_10.mesh.visible)
 mana.set_live_state(10,3);assert(not mana.pieces.crystal_10.root.visible)
 mana.advance_live(2.0);assert(hidden.destroy_state.root.visible and hidden.particle_players.size()==2)
 assert(hidden.transform.is_equal_approx(hidden_pose))
 mana.advance_live(1.0);assert(mana.retiring_crystals.is_empty())
 await process_frame;await process_frame;await process_frame
 root.get_node("SoundManager").stop_all_sfx()
 await create_timer(0.2).timeout
 mana.queue_free();renderer.queue_free();await process_frame
 print("PHONE_MANA_LIVE_STATE_PASS source state/prime/curves/null callbacks/birth companion/temp destroy particles+finish");quit()
