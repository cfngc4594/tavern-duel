extends Node3D
## Source ParticleSystem modules, with an explicit Godot compatibility solver.
## Unity's native RNG, integration and billboard rasterization are not recovered.
const Curves = preload("res://original_board/scripts/source_particle_curves.gd")
const STEP := 1.0 / 120.0
const EPSILON := 0.00000001
const SUPPORTED_MODULES := ["InitialModule", "ShapeModule", "EmissionModule", "SizeModule", "ColorModule", "UVModule", "VelocityModule", "ClampVelocityModule", "RotationModule", "RotationBySpeedModule", "ForceModule", "InheritVelocityModule", "CollisionModule", "SubModule"]
var raw: Dictionary = {}
var source_renderer: Dictionary = {}
var particles: Array = []
var mesh := ArrayMesh.new()
var elapsed_seconds := 0.0
var active := false
var emission_playing := true
var runtime_emission_rate := -1.0
var runtime_emission_fraction := 0.0
# Opt-in for new environmental rows; legacy controller behavior stays unchanged.
var constant_rate_carry := false
var constant_source_rate := -1.0
var source_sort_mode := false
var source_transform := Transform3D.IDENTITY
var source_key := ""
var capture_camera_right:=Vector3.ZERO
var capture_camera_up:=Vector3.ZERO
var material: Material
var source_node: Node3D
var mesh_instance: MeshInstance3D
var compatibility_basis := Basis.IDENTITY
var rng := RandomNumberGenerator.new()
var unsupported: Array = []
var enabled_modules: Array = []
var period_events: Array = []
var next_cycle := 0
var pending_events: Array = []
var simulation_time := -EPSILON
var stop_time := INF
var start_delay := 0.0
var duration := 1.0
var last_emitter := Transform3D.IDENTITY
var last_local_scale := Vector3.ONE
var mesh_triangles: Array = []
var mesh_area := 0.0
var shape_mesh_vertices: Array = []
var source_render_mesh: ArrayMesh
var renderer_mesh_key := ""
var emitted_count := 0
var live_count := 0
var dropped_at_capacity := 0
var shape_mesh_key := ""
var source_destroyed := false
# Same-build Windows globalgamemanagers PhysicsManager path10, MD5 verified.
# Coordinate conjugation remains in _force_acceleration, not in this source value.
var source_gravity := Vector3(0.0, -9.8100004196167, 0.0)
var source_gravity_verified := true
var compatibility_notes: Array = []
var collision_planes: Array = []
var collision_count := 0
var null_collision_planes := 0
var null_subemitters := 0
var emitter_velocity := Vector3.ZERO
var last_wall_seconds := 0.0
var playback_speed := 1.0
var speed_segments: Array = []
var warmup_seconds := 0.0
var subemitter_templates: Array = []
var subemitter_emitted := 0
var source_scope_root: Node3D
var source_assets
var instance_seed := 0
var subemitter_ancestry: Array = []
var death_rng := RandomNumberGenerator.new()
var death_events := 0
var screen_size_clamped := 0

func setup(spec: Dictionary, assets, parent_root: Node3D, seed_value: int) -> void:
	emission_playing = bool(spec.get("autoplay", true))
	constant_rate_carry = bool(spec.get("constant_rate_carry", false))
	source_sort_mode = bool(spec.get("source_sort_mode", false))
	raw = spec.system.data.duplicate(true)
	playback_speed = float(raw.get("simulationSpeed", 1.0))
	speed_segments = [{"at": 0.0, "sim": 0.0, "speed": playback_speed}]
	source_renderer = spec.renderer.get("data", {})
	source_key = spec.system.key
	source_node = spec.node
	parent_root.add_child(self)
	# Remain owned by the effect container for cancellation, but do not inherit
	# its motion twice. World particles retain their birth transform; local
	# particles explicitly use the source emitter's current transform below.
	top_level = true
	global_transform = Transform3D.IDENTITY
	compatibility_basis = spec.get("compatibility_basis", parent_root.global_basis)
	source_scope_root = spec.get("source_scope_root", parent_root)
	source_assets = assets
	instance_seed = seed_value
	subemitter_ancestry = spec.get("subemitter_ancestry", []).duplicate()
	subemitter_ancestry.append(source_key)
	death_rng.seed = seed_value + 15485863
	last_emitter = source_node.global_transform
	last_local_scale = source_node.scale
	source_transform = last_emitter
	material = assets.material(str(spec.renderer.get("refs", {}).get(".m_Materials[0]", "")))
	mesh_instance = MeshInstance3D.new()
	mesh_instance.mesh = mesh
	mesh_instance.material_override = material
	mesh_instance.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	add_child(mesh_instance)
	# This is deliberately independent of game.rng and of global randf().
	rng.seed = seed_value
	start_delay = maxf(0.0, Curves.minmax(raw.get("startDelay", {}), 0.0, rng.randf()))
	duration = maxf(EPSILON, float(raw.get("lengthInSec", 1.0)))
	if bool(raw.get("prewarm", false)) and bool(raw.get("looping", false)) and emission_playing:
		warmup_seconds = duration
		speed_segments[0].sim = warmup_seconds
	for module in raw:
		if raw[module] is Dictionary and bool(raw[module].get("enabled", false)):
			enabled_modules.append(module)
			if not SUPPORTED_MODULES.has(module): _unsupported(module)
	_load_collision_planes(spec, assets, source_scope_root)
	_validate_used_fields()
	_load_shape_mesh(spec, assets)
	_load_renderer_mesh(spec, assets)
	_build_emission_period()
	_load_subemitters(spec)
	seek(0.0)

func _unsupported(field: String) -> void:
	if not unsupported.has(field): unsupported.append(field)

func _validate_used_fields() -> void:
	if int(raw.get("moveWithTransform", 0)) not in [0, 1]: _unsupported("custom simulation space")
	if bool(raw.get("prewarm", false)) and bool(raw.get("looping", false)): compatibility_notes.append("prewarm advances one original duration through the compatibility solver before time zero")
	var initial: Dictionary = raw.get("InitialModule", {})
	if bool(initial.get("size3D", false)): _unsupported("InitialModule.size3D")
	if bool(initial.get("rotation3D", false)): _unsupported("InitialModule.rotation3D")
	if _curve_nonzero(initial.get("gravityModifier", {})) and not source_gravity_verified: compatibility_notes.append("InitialModule gravity uses explicit unverified scene vector (0,-9.81,0)")
	var shape: Dictionary = raw.get("ShapeModule", {})
	if bool(shape.get("enabled", false)):
		if int(shape.get("type", -1)) not in [0, 1, 2, 3, 4, 5, 6, 10]: _unsupported("ShapeModule.type=" + str(shape.get("type")))
		for field in ["sphericalDirectionAmount", "randomPositionAmount"]:
			if float(shape.get(field, 0.0)) != 0.0: _unsupported("ShapeModule." + field)
		if int(shape.get("type", 0)) == 6 and int(shape.get("placementMode", 0)) not in [0, 2]: _unsupported("ShapeModule mesh placement other than Vertex/Triangle")
		if int(shape.get("type", 0)) == 10 and int(shape.get("arc", {}).get("mode", 0)) != 0: _unsupported("ShapeModule non-random arc mode")
	var emission: Dictionary = raw.get("EmissionModule", {})
	if bool(emission.get("enabled", false)):
		if int(emission.get("rateOverTime", {}).get("minMaxState", 0)) != 0: compatibility_notes.append("curve rateOverTime integrated at 1/120 sec with fractional emission carry")
		if _curve_nonzero(emission.get("rateOverDistance", {})): _unsupported("EmissionModule.rateOverDistance")
	for name in ["SizeModule", "RotationModule", "RotationBySpeedModule", "ForceModule", "InheritVelocityModule", "CollisionModule", "SubModule"]:
		var module: Dictionary = raw.get(name, {})
		if bool(module.get("enabled", false)) and bool(module.get("separateAxes", false)): _unsupported(name + ".separateAxes")
	var velocity: Dictionary = raw.get("VelocityModule", {})
	if bool(velocity.get("enabled", false)):
		for field in ["orbitalX", "orbitalY", "orbitalZ", "orbitalOffsetX", "orbitalOffsetY", "orbitalOffsetZ", "radial"]:
			if _curve_nonzero(velocity.get(field, {})) and not compatibility_notes.has("orbital/radial velocities use local fixed-step omega-cross-radius integration; angular units interpreted as radians/sec"):
				compatibility_notes.append("orbital/radial velocities use local fixed-step omega-cross-radius integration; angular units interpreted as radians/sec")
	var force: Dictionary = raw.get("ForceModule", {})
	if bool(force.get("enabled", false)) and bool(force.get("randomizePerFrame", false)): compatibility_notes.append("ForceModule.randomizePerFrame resamples per particle at fixed 1/120 simulation-second steps using deterministic instance-seeded mixing; original Unity frame cadence and RNG are unavailable")
	var inherit: Dictionary = raw.get("InheritVelocityModule", {})
	if bool(inherit.get("enabled", false)):
		if int(inherit.get("m_Mode", 0)) != 0: _unsupported("InheritVelocityModule.Current")
		compatibility_notes.append("initial inherited velocity derives from sampled source Transform motion, not Unity native velocity cache")
	var collision: Dictionary = raw.get("CollisionModule", {})
	if bool(collision.get("enabled", false)) and int(collision.get("type", 0)) != 0: _unsupported("CollisionModule.World")
	var sub: Dictionary = raw.get("SubModule", {})
	if bool(sub.get("enabled", false)):
		for emitter in sub.get("subEmitters", []):
			if int(emitter.get("emitter", {}).get("m_PathID", 0)) == 0: null_subemitters += 1
			elif int(emitter.get("type", 0)) not in [0, 2]: _unsupported("SubModule emitter type=" + str(emitter.get("type")))
			elif int(emitter.get("properties", 0)) != 0: _unsupported("SubModule inherited properties")
	var uv_module: Dictionary = raw.get("UVModule", {})
	if bool(uv_module.get("enabled", false)) and int(uv_module.get("mode", 0)) != 0: _unsupported("UVModule Sprites mode")
	if int(source_renderer.get("m_RenderMode", 0)) not in [0, 1, 2, 4]: _unsupported("renderer mode=" + str(source_renderer.get("m_RenderMode")))
	if int(source_renderer.get("m_RenderAlignment", 0)) != 0 and not (int(source_renderer.get("m_RenderMode", 0)) == 4 and int(source_renderer.get("m_RenderAlignment", 0)) in [1, 2]): _unsupported("renderer alignment other than View/mesh World/mesh Local")
	if float(source_renderer.get("m_CameraVelocityScale", 0.0)) != 0.0: _unsupported("renderer camera velocity stretch")

static func _curve_nonzero(curve: Dictionary) -> bool:
	return absf(Curves.minmax(curve, 0.0, 0.0)) > EPSILON or absf(Curves.minmax(curve, 0.5, 0.5)) > EPSILON or absf(Curves.minmax(curve, 1.0, 1.0)) > EPSILON

func _load_shape_mesh(spec: Dictionary, assets) -> void:
	if int(raw.get("ShapeModule", {}).get("type", -1)) != 6: return
	shape_mesh_key = str(spec.system.get("refs", {}).get(".ShapeModule.m_Mesh", ""))
	var source_mesh: ArrayMesh = assets.geometry(shape_mesh_key)
	if source_mesh == null:
		_unsupported("missing original shape mesh " + shape_mesh_key)
		return
	var shape: Dictionary = raw.ShapeModule
	for surface in range(source_mesh.get_surface_count()):
		if bool(shape.get("m_UseMeshMaterialIndex", false)) and surface != int(shape.get("m_MeshMaterialIndex", 0)): continue
		var arrays: Array = source_mesh.surface_get_arrays(surface)
		var points: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
		var normals = arrays[Mesh.ARRAY_NORMAL]
		var colors = arrays[Mesh.ARRAY_COLOR]
		var indices = arrays[Mesh.ARRAY_INDEX]
		for i in range(points.size()):
			shape_mesh_vertices.append({"point": points[i], "normal": normals[i] if normals != null and normals.size() == points.size() else Vector3.BACK, "color": colors[i] if colors != null and colors.size() == points.size() else Color.WHITE})
		if indices == null or indices.is_empty():
			indices = PackedInt32Array()
			for i in range(points.size()): indices.append(i)
		for i in range(0, indices.size() - 2, 3):
			var ids := Vector3i(indices[i], indices[i + 1], indices[i + 2])
			var a := points[ids.x]; var b := points[ids.y]; var c := points[ids.z]
			var cross := (b - a).cross(c - a)
			var area := cross.length() * 0.5
			if area <= EPSILON: continue
			mesh_area += area
			var ns: Array = [cross.normalized(), cross.normalized(), cross.normalized()]
			var cs: Array = [Color.WHITE, Color.WHITE, Color.WHITE]
			for j in range(3):
				if normals != null and normals.size() == points.size(): ns[j] = normals[ids[j]]
				if colors != null and colors.size() == points.size(): cs[j] = colors[ids[j]]
			mesh_triangles.append({"points": [a, b, c], "normals": ns, "colors": cs, "area_end": mesh_area})

func _build_emission_period() -> void:
	var emission: Dictionary = raw.get("EmissionModule", {})
	if not bool(emission.get("enabled", false)): return
	# Play(withChildren) does not enable a disabled EmissionModule. In
	# particular the source EdgeLandMotes' serialized bursts stay disabled.
	for burst in emission.get("m_Bursts", []):
		var repeats := int(burst.get("cycleCount", 1))
		var interval := float(burst.get("repeatInterval", 0.0))
		if repeats == 0: repeats = maxi(1, int(ceil(duration / maxf(interval, STEP))))
		for repeat in range(repeats):
			var at := float(burst.get("time", 0.0)) + repeat * interval
			if at > duration + EPSILON: continue
			period_events.append({"at": at, "burst": burst})
	var rate_curve: Dictionary = emission.get("rateOverTime", {})
	if int(rate_curve.get("minMaxState", 0)) == 0:
		var rate := maxf(0.0, Curves.minmax(rate_curve, 0.0))
		if constant_rate_carry:
			constant_source_rate = rate
		elif rate > 0.0:
			for i in range(1, int(floor(duration * rate + EPSILON)) + 1):
				period_events.append({"at": float(i) / rate, "count": 1})
	else:
		# Integrate actual source Hermite curves, not a hand-set constant rate.
		# This numeric quadrature is an explicit replacement for Unity native emission.
		var accumulator := 0.0
		var threshold := 1.0
		var at := 0.0
		var rate_mix := rng.randf()
		while at < duration - EPSILON:
			var end := minf(duration, at + STEP)
			var r0 := maxf(0.0, Curves.minmax(rate_curve, at / duration, rate_mix))
			var r1 := maxf(0.0, Curves.minmax(rate_curve, end / duration, rate_mix))
			var area := (r0 + r1) * 0.5 * (end - at)
			while threshold <= accumulator + area + EPSILON:
				var weight := clampf((threshold - accumulator) / maxf(EPSILON, area), 0.0, 1.0)
				period_events.append({"at": lerpf(at, end, weight), "count": 1})
				threshold += 1.0
			accumulator += area
			at = end
	period_events.sort_custom(func(a, b): return float(a.at) < float(b.at))

func stop_emitting(seconds: float = -1.0) -> void:
	# Unity Stop(bool) forwards StopEmitting (1), not StopEmittingAndClear.
	var requested := elapsed_seconds if seconds < 0.0 else maxf(seconds, 0.0)
	stop_time = minf(stop_time, _to_sim_time(requested))
	# Also handle a caller delivering a source stop event after a coarse seek.
	particles = particles.filter(func(p): return bool(p.get("manual_emit", false)) or float(p.birth) <= stop_time)
	pending_events = pending_events.filter(func(event): return float(event.at) < stop_time)
	seek(elapsed_seconds)

func stop(seconds: float = -1.0) -> void:
	stop_emitting(seconds)

func source_destroy() -> void:
	source_destroyed = true
	active = false
	live_count = 0
	stop_time = 0.0
	particles.clear()
	pending_events.clear()
	mesh.clear_surfaces()
	for template in subemitter_templates:
		if is_instance_valid(template.solver): template.solver.source_destroy()
	if is_instance_valid(mesh_instance): mesh_instance.visible = false

func _to_sim_time(seconds: float) -> float:
	for index in range(speed_segments.size() - 1, -1, -1):
		var segment: Dictionary = speed_segments[index]
		if seconds >= float(segment.at): return float(segment.sim) + (seconds - float(segment.at)) * float(segment.speed)
	return 0.0

func set_playback_speed(value: float, at_seconds: float = -1.0) -> void:
	var at := elapsed_seconds if at_seconds < 0.0 else maxf(0.0, at_seconds)
	seek(at)
	var sim := _to_sim_time(at)
	playback_speed = maxf(0.0, value)
	speed_segments.append({"at": at, "sim": sim, "speed": playback_speed})
	for template in subemitter_templates: template.solver.set_playback_speed(value, at)

func set_emission_rate(value: float, at_seconds: float = -1.0) -> void:
	var at := elapsed_seconds if at_seconds < 0.0 else maxf(0.0,at_seconds)
	# Finish the old rate interval before changing its future value. Never rebuild
	# prior births or consume the rules RNG when a PlayMaker property changes.
	seek(at)
	runtime_emission_rate=maxf(0.0,value)

func _runtime_rate_events(now: float) -> void:
	var effective_rate:float=runtime_emission_rate if runtime_emission_rate>=0.0 else constant_source_rate
	if effective_rate<0.0 or not emission_playing or not bool(raw.get("EmissionModule",{}).get("enabled",false)):return
	var begin:=maxf(simulation_time,start_delay)
	var end:=minf(now,stop_time)
	if not bool(raw.get("looping",false)):end=minf(end,start_delay+duration)
	if end<=begin or effective_rate<=0.0:return
	var amount: float=runtime_emission_fraction+(end-begin)*effective_rate
	var count:=int(floor(amount+EPSILON))
	for index in range(count):
		var at:=begin+(float(index+1)-runtime_emission_fraction)/effective_rate
		pending_events.append({"at":at,"count":1,"runtime_rate":true})
	runtime_emission_fraction=maxf(0.0,amount-float(count))

func bind_scene_gravity(value: Vector3, verified: bool = false) -> void:
	source_gravity = value
	source_gravity_verified = verified

func _emitter_transform() -> Transform3D:
	return source_node.global_transform if is_instance_valid(source_node) else last_emitter

func _emitter_scale() -> Vector3:
	return source_node.scale if is_instance_valid(source_node) else last_local_scale

func _rotation_decomposable(basis: Basis) -> bool:
	# Test normalized orthogonality, not absolute determinant: tiny but valid
	# uniformly scaled transforms must retain the normal rotation interpolation.
	if basis.determinant() < 0.0:return false
	if basis.x.length_squared()==0.0 or basis.y.length_squared()==0.0 or basis.z.length_squared()==0.0:return false
	var x:=basis.x.normalized();var y:=basis.y.normalized();var z:=basis.z.normalized()
	return absf(x.dot(y))<0.00001 and absf(x.dot(z))<0.00001 and absf(y.dot(z))<0.00001

func _birth_frame(at: float, now: float, current: Transform3D) -> Transform3D:
	if now <= simulation_time + EPSILON: return current
	var weight := clampf((at - simulation_time) / (now - simulation_time), 0.0, 1.0)
	# The caller supplies sampled source animation. Interpolation of its birth
	# transforms is a compatibility boundary, not recovered native scheduling.
	if not _rotation_decomposable(last_emitter.basis) or not _rotation_decomposable(current.basis):
		# A source scale axis can be exactly zero during Birth, or a hierarchy
		# of nonuniform scales and rotations can produce shear. Such a matrix has
		# no unique quaternion decomposition. Preserve its exact affine endpoints
		# and interpolate columns only for this non-decomposable interval; never invent
		# a nonzero scale or feed a singular basis to Godot's quaternion cast.
		# This bounded affine interpolation is an explicit native-solver
		# compatibility choice, not a recovered Unity decomposition algorithm.
		return Transform3D(Basis(last_emitter.basis.x.lerp(current.basis.x,weight),last_emitter.basis.y.lerp(current.basis.y,weight),last_emitter.basis.z.lerp(current.basis.z,weight)),last_emitter.origin.lerp(current.origin,weight))
	return last_emitter.interpolate_with(current, weight)

func _emit_until(now: float, current: Transform3D, local_scale: Vector3) -> void:
	if not emission_playing or (period_events.is_empty() and pending_events.is_empty()): return
	var end := minf(now, stop_time)
	while start_delay + next_cycle * duration <= end + EPSILON:
		if next_cycle > 0 and not bool(raw.get("looping", false)): break
		var base := start_delay + next_cycle * duration
		for event in period_events:
			var item: Dictionary = event.duplicate()
			item.at = base + float(event.at)
			if float(item.at) < stop_time: pending_events.append(item)
		next_cycle += 1
	var remaining: Array = []
	for event in pending_events:
		var at: float = event.at
		if at > now + EPSILON:
			remaining.append(event)
			continue
		if at >= stop_time: continue
		if runtime_emission_rate>=0.0 and not event.has("burst") and not bool(event.get("runtime_rate",false)):continue
		var count: int = event.get("count", 0)
		if event.has("burst"):
			if rng.randf() > float(event.burst.get("probability", 1.0)): continue
			count = maxi(0, int(Curves.minmax(event.burst.countCurve, fposmod(at - start_delay, duration) / duration, rng.randf())))
		var frame := _birth_frame(at, now, current)
		var weight := 1.0 if now <= simulation_time + EPSILON else clampf((at - simulation_time) / (now - simulation_time), 0.0, 1.0)
		var birth_scale := last_local_scale.lerp(local_scale, weight)
		var living_at_birth := 0
		for p in particles:
			if float(p.birth) <= at and float(p.birth) + minf(float(p.life), float(p.get("kill_age", INF))) > at: living_at_birth += 1
		var available := maxi(0, int(raw.get("InitialModule", {}).get("maxNumParticles", 1000)) - living_at_birth)
		dropped_at_capacity += maxi(0, count - available)
		for _index in range(mini(count, available)): _spawn_particle(at, frame, birth_scale)
	pending_events = remaining

func _sample_shape() -> Dictionary:
	var shape: Dictionary = raw.get("ShapeModule", {})
	var point := Vector3.ZERO
	var direction := Vector3.BACK # Unity shape's +Z emission direction.
	var shape_color := Color.WHITE
	if bool(shape.get("enabled", false)):
		match int(shape.get("type", -1)):
			0, 1, 2, 3:
				# Source sphere/hemisphere volume geometry; PCG distribution is not Unity RNG.
				var shape_type := int(shape.get("type", 0))
				var z := rng.randf() if shape_type in [2, 3] else rng.randf_range(-1.0, 1.0)
				var azimuth := rng.randf() * TAU
				var radial := sqrt(maxf(0.0, 1.0 - z * z))
				direction = Vector3(radial * cos(azimuth), radial * sin(azimuth), z)
				var radius := float(shape.get("radius", {}).get("value", 1.0))
				var thickness := clampf(float(shape.get("radiusThickness", 1.0)), 0.0, 1.0)
				if shape_type in [1, 3]: thickness = 0.0
				point = direction * radius * pow(lerpf(pow(1.0 - thickness, 3.0), 1.0, rng.randf()), 1.0 / 3.0)
			4:
				# Source Cone emits from the base disk (+Z), not a sphere or invented plume.
				# Direction interpolation inside its aperture is a documented compatibility solver.
				var azimuth := rng.randf() * deg_to_rad(float(shape.get("arc", {}).get("value", 360.0)))
				var thickness := clampf(float(shape.get("radiusThickness", 1.0)), 0.0, 1.0)
				var radial := sqrt(lerpf(pow(1.0 - thickness, 2.0), 1.0, rng.randf()))
				var radius := float(shape.get("radius", {}).get("value", 1.0))
				point = Vector3(cos(azimuth), sin(azimuth), 0.0) * radial * radius
				var aperture := deg_to_rad(clampf(float(shape.get("angle", 25.0)), 0.0, 90.0))
				direction = Vector3(cos(azimuth) * radial * sin(aperture), sin(azimuth) * radial * sin(aperture), cos(aperture)).normalized()
			5:
				point = Vector3(rng.randf() - 0.5, rng.randf() - 0.5, rng.randf() - 0.5)
			6:
				if int(shape.get("placementMode", 0)) == 0:
					if shape_mesh_vertices.is_empty(): return {}
					var vertex: Dictionary = shape_mesh_vertices[rng.randi_range(0, shape_mesh_vertices.size() - 1)]
					point = vertex.point; direction = vertex.normal.normalized(); shape_color = vertex.color
				elif int(shape.get("placementMode", 0)) == 2:
					if mesh_triangles.is_empty(): return {}
					var area_choice := rng.randf() * mesh_area
					var triangle: Dictionary = mesh_triangles[-1]
					for candidate in mesh_triangles:
						if area_choice <= float(candidate.area_end): triangle = candidate; break
					var root_u := sqrt(rng.randf())
					var weights := Vector3(1.0 - root_u, root_u * (1.0 - rng.randf()), 0.0)
					weights.z = 1.0 - weights.x - weights.y
					direction = Vector3.ZERO
					shape_color = Color(0, 0, 0, 0)
					for j in range(3):
						point += triangle.points[j] * weights[j]
						direction += triangle.normals[j] * weights[j]
						shape_color += triangle.colors[j] * weights[j]
					direction = direction.normalized()
				else: return {}
				point += direction * float(shape.get("m_MeshNormalOffset", 0.0))
				if not bool(shape.get("m_UseMeshColors", true)): shape_color = Color.WHITE
			10:
				var angle := rng.randf() * deg_to_rad(float(shape.get("arc", {}).get("value", 360.0)))
				direction = Vector3(cos(angle), sin(angle), 0)
				var radius := float(shape.get("radius", {}).get("value", 1.0))
				var thickness := clampf(float(shape.get("radiusThickness", 1.0)), 0.0, 1.0)
				if thickness > 0.0: radius *= sqrt(lerpf(pow(1.0 - thickness, 2), 1.0, rng.randf()))
				point = direction * radius
			_:
				return {} # Do not invent a shape for unsupported source modules.
		var shape_basis := Basis.from_euler(Curves.vec(shape.get("m_Rotation", {})) * PI / 180.0, EULER_ORDER_YXZ)
		point = shape_basis * (point * Curves.vec(shape.get("m_Scale", {"x": 1, "y": 1, "z": 1}))) + Curves.vec(shape.get("m_Position", {}))
		var random_direction := clampf(float(shape.get("randomDirectionAmount", 0.0)), 0.0, 1.0)
		if random_direction > 0.0:
			var z := rng.randf_range(-1.0, 1.0)
			var azimuth := rng.randf() * TAU
			var radial := sqrt(maxf(0.0, 1.0 - z * z))
			direction = direction.lerp(Vector3(radial * cos(azimuth), radial * sin(azimuth), z), random_direction).normalized()
		direction = shape_basis * direction
	return {"point": point, "direction": direction, "color": shape_color}

func _motion_basis(frame: Transform3D, local_scale: Vector3) -> Basis:
	var source_basis := compatibility_basis.inverse() * frame.basis
	match int(raw.get("scalingMode", 0)):
		0: return frame.basis
		1: return compatibility_basis * source_basis.orthonormalized().scaled_local(local_scale)
		2: return compatibility_basis * source_basis.orthonormalized()
	return frame.basis

func _spawn_particle(at: float, frame: Transform3D, local_scale: Vector3) -> void:
	var sample := _sample_shape()
	if sample.is_empty(): return
	var initial: Dictionary = raw.get("InitialModule", {})
	var phase := fposmod(maxf(0.0, at - start_delay), duration) / duration
	var life := maxf(0.0, Curves.minmax(initial.get("startLifetime", {}), phase, rng.randf()))
	if life <= 0.0: return
	var rotation := Curves.minmax(initial.get("startRotation", {}), phase, rng.randf())
	if rng.randf() < float(initial.get("randomizeRotationDirection", 0.0)): rotation *= -1.0
	var speed := Curves.minmax(initial.get("startSpeed", {}), phase, rng.randf())
	var p: Dictionary = {"birth": at, "life": life, "size": Curves.minmax(initial.get("startSize", {}), phase, rng.randf()), "shape_point": sample.point, "start": frame * sample.point, "birth_frame": frame, "birth_scale": local_scale, "motion_basis": _motion_basis(frame, local_scale), "velocity": sample.direction * speed, "color": sample.color * sample_color(initial.get("startColor", {}), phase, rng.randf()), "rotation": rotation, "size_mix": rng.randf(), "color_mix": rng.randf(), "limit_mix": rng.randf(), "tile_mix": rng.randf(), "tile_start_mix": rng.randf(), "rotation_mix": rng.randf(), "velocity_mix": Vector3(rng.randf(), rng.randf(), rng.randf()), "row_mix": rng.randf(), "flip_u": rng.randf(), "flip_v": rng.randf(), "sim_age": 0.0, "displacement": Vector3.ZERO, "sim_rotation": rotation}
	p.force_mix = Vector3(rng.randf(), rng.randf(), rng.randf())
	p.gravity_mix = rng.randf()
	p.inherit_mix = rng.randf()
	p.inherited_velocity = emitter_velocity
	p.kill_age = INF
	p.collision_loss = 0.0
	p.collision_hits = 0
	p.sim_velocity = p.velocity + _velocity_over_life(p, 0.0) + _inherit_velocity(p, 0.0)
	p.sim_render_velocity = p.sim_velocity + _spatial_velocity(p, Vector3.ZERO, 0.0)
	p.sub_cursors = []
	p.sub_probabilities = []
	for template in subemitter_templates:
		p.sub_cursors.append(1)
		p.sub_probabilities.append(rng.randf() <= float(template.probability) if int(template.type) == 0 else true)
	particles.append(p)
	emitted_count += 1

static func gradient(d: Dictionary, t: float) -> Color:
	var result := Color.WHITE
	for part in ["color", "alpha"]:
		var count := int(d.get("m_NumColorKeys" if part == "color" else "m_NumAlphaKeys", 0))
		if count == 0: continue
		var times: Array = []
		for i in range(count): times.append(float(d.get(("ctime" if part == "color" else "atime") + str(i), 0)) / 65535.0)
		var index := 0
		while index < count - 1 and t >= float(times[index + 1]): index += 1
		var a := Curves.color(d.get("key" + str(index), {}))
		var b := Curves.color(d.get("key" + str(mini(index + 1, count - 1)), {}))
		var u := 0.0
		if index < count - 1 and float(times[index + 1]) > float(times[index]): u = clampf((t - float(times[index])) / (float(times[index + 1]) - float(times[index])), 0.0, 1.0)
		if int(d.get("m_Mode", 0)) == 1: u = 0.0
		var c := a.lerp(b, u)
		if part == "color": result.r = c.r; result.g = c.g; result.b = c.b
		else: result.a = c.a
	return result

static func sample_color(d: Dictionary, t: float, mix_value: float) -> Color:
	match int(d.get("minMaxState", 0)):
		0: return Curves.color(d.get("maxColor", {}))
		1: return gradient(d.get("maxGradient", {}), t)
		2: return Curves.color(d.get("minColor", {})).lerp(Curves.color(d.get("maxColor", {})), mix_value)
		3: return gradient(d.get("minGradient", {}), t).lerp(gradient(d.get("maxGradient", {}), t), mix_value)
		4: return gradient(d.get("maxGradient", {}), mix_value)
	return Color.WHITE

func _velocity_over_life(p: Dictionary, normalized: float) -> Vector3:
	var module: Dictionary = raw.get("VelocityModule", {})
	if not bool(module.get("enabled", false)): return Vector3.ZERO
	var velocity := Vector3(Curves.minmax(module.get("x", {}), normalized, p.velocity_mix.x), Curves.minmax(module.get("y", {}), normalized, p.velocity_mix.y), Curves.minmax(module.get("z", {}), normalized, p.velocity_mix.z))
	if bool(module.get("inWorldSpace", false)): velocity = p.motion_basis.inverse() * (compatibility_basis * velocity)
	return velocity

func _integrate(p: Dictionary, state: Dictionary, dt: float) -> Dictionary:
	return _integrate_step(p, state, dt, false)

func _integrate_step(p: Dictionary, state: Dictionary, dt: float, reuse_state: bool) -> Dictionary:
	var normalized := clampf((float(state.age) + dt) / float(p.life), 0.0, 1.0)
	var velocity: Vector3 = state.velocity
	# Velocity-over-life is an additive velocity, not an acceleration added
	# every step. Apply the difference from its preceding sample.
	velocity += _velocity_over_life(p, normalized) - _velocity_over_life(p, float(state.age) / float(p.life))
	velocity += _inherit_velocity(p, normalized) - _inherit_velocity(p, float(state.age) / float(p.life))
	velocity += _acceleration(p, normalized, int(floor((float(state.age) + EPSILON) / STEP))) * dt
	var limit: Dictionary = raw.get("ClampVelocityModule", {})
	if bool(limit.get("enabled", false)):
		var amount := 1.0 - pow(1.0 - clampf(float(limit.get("dampen", 0.0)), 0.0, 1.0), dt / STEP)
		if bool(limit.get("separateAxis", false)):
			for axis in range(3):
				var cap := maxf(0.0, Curves.minmax(limit.get(["x", "y", "z"][axis], {}), normalized, p.limit_mix))
				velocity[axis] = lerpf(velocity[axis], clampf(velocity[axis], -cap, cap), amount)
		else:
			var cap := maxf(0.0, Curves.minmax(limit.get("magnitude", {}), normalized, p.limit_mix))
			var speed := velocity.length()
			if speed > cap: velocity *= lerpf(speed, cap, amount) / speed
		var drag := maxf(0.0, Curves.minmax(limit.get("drag", {}), normalized, p.limit_mix))
		if drag > 0.0:
			if bool(limit.get("multiplyDragByParticleSize", false)): drag *= float(p.size)
			if bool(limit.get("multiplyDragByParticleVelocity", false)): drag *= velocity.length()
			velocity *= maxf(0.0, 1.0 - drag * dt)
	var rotation: float = state.rotation
	var rotation_module: Dictionary = raw.get("RotationModule", {})
	if bool(rotation_module.get("enabled", false)): rotation += Curves.minmax(rotation_module.get("curve", {}), normalized, p.rotation_mix) * dt
	var by_speed: Dictionary = raw.get("RotationBySpeedModule", {})
	if bool(by_speed.get("enabled", false)):
		var speed_range: Dictionary = by_speed.get("range", {})
		var span := float(speed_range.get("y", 1.0)) - float(speed_range.get("x", 0.0))
		var speed_t := clampf((velocity.length() - float(speed_range.get("x", 0.0))) / maxf(span, EPSILON), 0.0, 1.0)
		rotation += Curves.minmax(by_speed.get("curve", {}), speed_t, p.rotation_mix) * dt
	var multiplier := 1.0
	if bool(raw.get("VelocityModule", {}).get("enabled", false)): multiplier = Curves.minmax(raw.VelocityModule.get("speedModifier", {"scalar": 1.0}), normalized, p.velocity_mix.x)
	var render_velocity := (velocity + _spatial_velocity(p, state.position, normalized)) * multiplier
	# Only the base solver's private full-step loop opts in. Collision handling
	# and overridden _integrate methods retain a distinct previous/next state.
	if reuse_state and collision_planes.is_empty():
		var next_position: Vector3 = state.position + render_velocity * dt
		state.age = float(state.age) + dt
		state.position = next_position; state.velocity = velocity
		state.render_velocity = render_velocity; state.rotation = rotation
		return state
	var next: Dictionary = {"age": float(state.age) + dt, "position": state.position + render_velocity * dt, "velocity": velocity, "render_velocity": render_velocity, "rotation": rotation, "kill_age": state.get("kill_age", INF), "collision_loss": state.get("collision_loss", 0.0), "collision_hits": state.get("collision_hits", 0)}
	return _resolve_collisions(p, state, next, normalized)

func _can_constant_step() -> bool:
	# Script subclasses may add integration behavior (for example Coin Noise).
	if get_script().get_base_script() != null: return false
	if not collision_planes.is_empty(): return false
	for module_name in ["VelocityModule", "InheritVelocityModule", "ClampVelocityModule", "RotationBySpeedModule"]:
		if bool(raw.get(module_name, {}).get("enabled", false)): return false
	var force: Dictionary = raw.get("ForceModule", {})
	if bool(force.get("enabled", false)):
		if bool(force.get("randomizePerFrame", false)): return false
		for axis in ["x", "y", "z"]:
			if int(force.get(axis, {}).get("minMaxState", 0)) != 0: return false
	if int(raw.get("InitialModule", {}).get("gravityModifier", {}).get("minMaxState", 0)) != 0: return false
	var rotation_module: Dictionary = raw.get("RotationModule", {})
	return not bool(rotation_module.get("enabled", false)) or int(rotation_module.get("curve", {}).get("minMaxState", 0)) == 0

func _constant_step_state(p: Dictionary, state: Dictionary, until: float) -> Dictionary:
	# Keep every original 1/120-second Euler step and arithmetic order. Only
	# constant module sampling and per-step Dictionary allocation are hoisted.
	var age: float = state.age
	if age + STEP > until + EPSILON: return state
	var velocity: Vector3 = state.velocity
	var position: Vector3 = state.position
	var rotation: float = state.rotation
	var acceleration_step: Vector3 = _acceleration(p, 0.0, 0) * STEP
	var rotation_module: Dictionary = raw.get("RotationModule", {})
	var rotates: bool = bool(rotation_module.get("enabled", false))
	var rotation_step: float = Curves.minmax(rotation_module.get("curve", {}), 0.0, p.rotation_mix) * STEP if rotates else 0.0
	while age + STEP <= until + EPSILON:
		velocity += acceleration_step
		if rotates: rotation += rotation_step
		position += velocity * STEP
		age += STEP
	state.age = age; state.position = position; state.velocity = velocity
	state.render_velocity = velocity; state.rotation = rotation
	return state

func _particle_state(p: Dictionary, age: float) -> Dictionary:
	if age + EPSILON < float(p.sim_age):
		p.sim_age = 0.0; p.displacement = Vector3.ZERO; p.sim_velocity = p.velocity + _velocity_over_life(p, 0.0) + _inherit_velocity(p, 0.0); p.sim_rotation = p.rotation; p.sim_render_velocity = p.sim_velocity + _spatial_velocity(p, Vector3.ZERO, 0.0); p.kill_age = INF; p.collision_loss = 0.0; p.collision_hits = 0
	var state: Dictionary = {"age": p.sim_age, "position": p.displacement, "velocity": p.sim_velocity, "rotation": p.sim_rotation, "render_velocity": p.sim_render_velocity, "kill_age": p.kill_age, "collision_loss": p.collision_loss, "collision_hits": p.collision_hits}
	if _can_constant_step():
		state = _constant_step_state(p, state, age)
	else:
		var reuse_state: bool = get_script().get_base_script() == null and collision_planes.is_empty()
		while float(state.age) + STEP <= age + EPSILON:
			state = _integrate_step(p, state, STEP, true) if reuse_state else _integrate(p, state, STEP)
	p.sim_age = state.age; p.displacement = state.position; p.sim_velocity = state.velocity; p.sim_rotation = state.rotation; p.sim_render_velocity = state.get("render_velocity", state.velocity); p.kill_age = state.kill_age; p.collision_loss = state.collision_loss; p.collision_hits = state.collision_hits
	if age > float(state.age) + EPSILON: state = _integrate(p, state, age - float(state.age))
	return state

func _position(p: Dictionary, time: float) -> Vector3:
	var state := _particle_state(p, time)
	if int(raw.get("moveWithTransform", 0)) == 1: return p.start + p.motion_basis * state.position
	var frame := _emitter_transform()
	return frame * p.shape_point + _motion_basis(frame, _emitter_scale()) * state.position

func _uv_corners(p: Dictionary, age: float, speed: float) -> Array:
	var uv_module: Dictionary = raw.get("UVModule", {})
	var cols := 1; var rows := 1; var tile := 0
	if bool(uv_module.get("enabled", false)) and int(uv_module.get("mode", 0)) == 0:
		cols = maxi(1, int(uv_module.get("tilesX", 1))); rows = maxi(1, int(uv_module.get("tilesY", 1)))
		var normalized := age / float(p.life)
		var phase := normalized
		if int(uv_module.get("timeMode", 0)) == 1:
			var limits: Dictionary = uv_module.get("speedRange", {})
			phase = clampf((speed - float(limits.get("x", 0.0))) / maxf(EPSILON, float(limits.get("y", 1.0)) - float(limits.get("x", 0.0))), 0.0, 1.0)
		var frame_count := cols * rows if int(uv_module.get("animationType", 0)) == 0 else cols
		var frame := Curves.minmax(uv_module.get("frameOverTime", {}), phase, p.tile_mix) * float(uv_module.get("cycles", 1.0))
		if int(uv_module.get("timeMode", 0)) == 2: frame = age * float(uv_module.get("fps", 30.0)) / frame_count
		# Serialized UVModule values are normalized: the Unity inspector remaps
		# both curves by tilesX*tilesY (or tilesX for SingleRow).
		frame += Curves.minmax(uv_module.get("startFrame", {}), 0.0, p.tile_start_mix)
		tile = posmod(int(floor(frame * frame_count)), frame_count)
		if int(uv_module.get("animationType", 0)) == 1:
			var row := int(uv_module.get("rowIndex", 0))
			if int(uv_module.get("rowMode", 0)) == 1: row = mini(rows - 1, int(p.row_mix * rows))
			tile += clampi(row, 0, rows - 1) * cols
	var origin := Vector2(tile % cols, int(tile / cols)) / Vector2(cols, rows)
	var corners: Array = []
	for corner in [Vector2(0, 0), Vector2(1, 0), Vector2(1, 1), Vector2(0, 1)]:
		if float(p.flip_u) < float(uv_module.get("flipU", 0.0)): corner.x = 1.0 - corner.x
		if float(p.flip_v) < float(uv_module.get("flipV", 0.0)): corner.y = 1.0 - corner.y
		corners.append(origin + corner / Vector2(cols, rows))
	return corners

func seek(seconds: float) -> void:
	elapsed_seconds = maxf(seconds, 0.0)
	# The wrapper is not the original emitter GO. Destroying that GO must also
	# destroy its particles, unlike an explicit StopEmitting action.
	if source_destroyed or not is_instance_valid(source_node) or source_node.is_queued_for_deletion():
		source_destroy()
		return
	var now := _to_sim_time(elapsed_seconds)
	var frame := _emitter_transform()
	var local_scale := _emitter_scale()
	if elapsed_seconds > last_wall_seconds + EPSILON:
		emitter_velocity = (frame.origin - last_emitter.origin) / (elapsed_seconds - last_wall_seconds)
	# Rewinding resamples existing particles; it must not restart an emitter.
	if now + EPSILON >= simulation_time:
		_runtime_rate_events(now)
		_emit_until(now, frame, local_scale)
		simulation_time = now; last_emitter = frame; last_local_scale = local_scale; last_wall_seconds = elapsed_seconds
	_update_subemitters(now)
	mesh.clear_surfaces()
	live_count = 0
	screen_size_clamped = 0
	collision_count = 0
	var vertices := PackedVector3Array(); var uvs := PackedVector2Array(); var colors := PackedColorArray(); var indices := PackedInt32Array(); var normals := PackedVector3Array()
	var camera: Camera3D = get_viewport().get_camera_3d() if is_inside_tree() else null
	var view_right := camera.global_basis.x.normalized() if camera != null else compatibility_basis.x.normalized()
	var view_up := camera.global_basis.y.normalized() if camera != null else compatibility_basis.y.normalized()
	if capture_camera_right.length_squared()>0.0:view_right=capture_camera_right.normalized()
	if capture_camera_up.length_squared()>0.0:view_up=capture_camera_up.normalized()
	var view_normal := view_right.cross(view_up).normalized()
	# Source sort mode 2 is OldestInFront: emit newest triangles first.
	# Opt-in preserves existing desktop adapters; no per-frame copy/sort required.
	var oldest_in_front := source_sort_mode and int(source_renderer.get("m_SortMode", 0)) == 2
	for particle_index in range(particles.size()):
		var p:Dictionary=particles[particles.size()-1-particle_index if oldest_in_front else particle_index]
		var age := now - float(p.birth)
		if age < 0.0 or age >= minf(float(p.life), float(p.get("kill_age", INF))) or (float(p.birth) > stop_time and not bool(p.get("manual_emit", false))): continue
		live_count += 1
		var normalized := age / float(p.life)
		var size: float = p.size
		if bool(raw.get("SizeModule", {}).get("enabled", false)): size *= Curves.minmax(raw.SizeModule.curve, normalized, p.size_mix)
		var color: Color = p.color
		if bool(raw.get("ColorModule", {}).get("enabled", false)): color *= sample_color(raw.ColorModule.gradient, normalized, p.color_mix)
		var state := _particle_state(p, age)
		collision_count += int(state.get("collision_hits", 0))
		if age >= float(state.get("kill_age", INF)): live_count -= 1; continue
		var world_space := int(raw.get("moveWithTransform", 0)) == 1
		var motion: Basis = p.motion_basis if world_space else _motion_basis(frame, local_scale)
		var center: Vector3 = p.start + motion * state.position if world_space else frame * p.shape_point + motion * state.position
		var velocity: Vector3 = motion * state.get("render_velocity", state.velocity)
		var scale_x := motion.x.length(); var scale_y := motion.y.length()
		var right := view_right; var up := view_up; var normal := view_normal
		var mode := int(source_renderer.get("m_RenderMode", 0))
		if mode == 4:
			var alignment := int(source_renderer.get("m_RenderAlignment", 0))
			var local_basis: Basis = motion.orthonormalized() if alignment == 2 else compatibility_basis.orthonormalized()
			local_basis = (local_basis * Basis(Vector3.BACK, float(state.rotation))).scaled_local(Vector3(motion.x.length(), motion.y.length(), motion.z.length()) * size)
			var output := _mesh_particle_geometry(Transform3D(local_basis, center), color, vertices.size())
			vertices.append_array(output.vertices); normals.append_array(output.normals); uvs.append_array(output.uvs); colors.append_array(output.colors); indices.append_array(output.indices)
			continue
		if mode == 2:
			right = compatibility_basis.x.normalized(); up = compatibility_basis.z.normalized()
			normal = right.cross(up).normalized(); scale_y = motion.z.length()
		elif mode == 1:
			var projected := velocity - view_normal * velocity.dot(view_normal)
			if projected.length_squared() > EPSILON: up = projected.normalized(); right = up.cross(view_normal).normalized()
			scale_y = scale_y * float(source_renderer.get("m_LengthScale", 1.0)) + velocity.length() * float(source_renderer.get("m_VelocityScale", 0.0)) / maxf(absf(size), EPSILON)
		var rotation: float = state.rotation
		# Stretched particles follow velocity when the source renderer requests it.
		if mode != 1 or not bool(source_renderer.get("m_RotateWithStretchDirection", true)):
			right = right.rotated(normal, rotation); up = up.rotated(normal, rotation)
		var x := right * size * scale_x * 0.5
		var y := up * size * scale_y * 0.5
		var screen_scale := _screen_size_scale(center, x, y, camera)
		if not is_equal_approx(screen_scale, 1.0): screen_size_clamped += 1
		x *= screen_scale; y *= screen_scale
		var start := vertices.size()
		for offset in [-x + y, x + y, x - y, -x - y]: vertices.append(center + offset); colors.append(color); normals.append(normal)
		for uv in _uv_corners(p, age, state.get("render_velocity", state.velocity).length()): uvs.append(uv)
		indices.append_array(PackedInt32Array([start, start + 1, start + 2, start, start + 2, start + 3]))
	var can_emit := emission_playing and bool(raw.get("EmissionModule", {}).get("enabled", false)) and (not period_events.is_empty() or runtime_emission_rate>0.0 or constant_source_rate>0.0) and now < stop_time and (bool(raw.get("looping", false)) or now <= start_delay + duration)
	active = live_count > 0 or can_emit
	for template in subemitter_templates: active = active or template.solver.active
	mesh_instance.visible = bool(source_renderer.get("m_Enabled", true)) and (not is_instance_valid(source_node) or source_node.is_visible_in_tree())
	if vertices.is_empty(): return
	var arrays: Array = []; arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = vertices; arrays[Mesh.ARRAY_TEX_UV] = uvs; arrays[Mesh.ARRAY_COLOR] = colors; arrays[Mesh.ARRAY_INDEX] = indices; arrays[Mesh.ARRAY_NORMAL] = normals
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)

func _projected_particle_fraction(center: Vector3, x: Vector3, y: Vector3, camera: Camera3D) -> float:
	var viewport_size := camera.get_viewport().get_visible_rect().size
	if viewport_size.x <= 0.0 or viewport_size.y <= 0.0: return 0.0
	var low := Vector2(INF, INF); var high := Vector2(-INF, -INF)
	for offset in [-x + y, x + y, x - y, -x - y]:
		var point := camera.unproject_position(center + offset)
		low = low.min(point); high = high.max(point)
	var extent := (high - low) / viewport_size
	return maxf(extent.x, extent.y)

func _screen_size_scale(center: Vector3, x: Vector3, y: Vector3, camera: Camera3D) -> float:
	# Unity Renderer module: min/max size are fractions of viewport size,
	# billboard modes only. Use actual projected quad bounds and viewport,
	# never alter the serialized size curves or simulation particle values.
	# The viewport-axis maximum is an explicit compatibility convention;
	# Unity's native size metric/rasterization has not been recovered.
	if camera == null or (not source_renderer.has("m_MinParticleSize") and not source_renderer.has("m_MaxParticleSize")): return 1.0
	if camera.is_position_behind(center): return 1.0
	var fraction := _projected_particle_fraction(center, x, y, camera)
	if fraction <= EPSILON: return 1.0
	var minimum := maxf(0.0, float(source_renderer.get("m_MinParticleSize", 0.0)))
	var maximum := maxf(minimum, float(source_renderer.get("m_MaxParticleSize", INF)))
	var target := clampf(fraction, minimum, maximum)
	if is_equal_approx(target, fraction): return 1.0
	var scale := target / fraction
	# Camera-facing quads have constant depth and are exactly linear. For
	# tilted billboards refine the same bound using the camera projection.
	if absf(camera.global_basis.z.dot(x)) + absf(camera.global_basis.z.dot(y)) > EPSILON:
		var low := 0.0; var high := maxf(1.0, scale * 2.0)
		for iteration in range(18):
			var middle := (low + high) * 0.5
			if _projected_particle_fraction(center, x * middle, y * middle, camera) > target: high = middle
			else: low = middle
		scale = (low + high) * 0.5
	return scale

func get_audit() -> Dictionary:
	return {"source_key": source_key, "original_count": emitted_count, "live_count": live_count, "elapsed": elapsed_seconds, "active": active, "runtime_emission_rate":runtime_emission_rate,"constant_source_rate":constant_source_rate,"constant_rate_carry":constant_rate_carry,"source_sort_mode":source_sort_mode,"emission_enabled": raw.get("EmissionModule", {}).get("enabled", false), "stop_seconds": _from_sim_time(stop_time) if is_finite(stop_time) else -1.0, "start_delay": start_delay, "simulation_space": raw.get("moveWithTransform", 0), "scaling_mode": raw.get("scalingMode", 0), "shape_type": raw.get("ShapeModule", {}).get("type"), "shape_mesh_key": shape_mesh_key, "source_mesh_triangles": mesh_triangles.size(), "source_mesh_vertices": shape_mesh_vertices.size(), "renderer_mesh_key": renderer_mesh_key, "renderer_mesh_surfaces": source_render_mesh.get_surface_count() if source_render_mesh != null else 0, "render_mode": source_renderer.get("m_RenderMode"), "enabled_modules": enabled_modules.duplicate(), "source_fields_supported": unsupported.is_empty(), "original_modules": false, "compatibility_notes": compatibility_notes.duplicate(), "collision_planes": collision_planes.size(), "collision_count": collision_count, "null_collision_planes": null_collision_planes, "null_subemitters": null_subemitters, "playback_speed": playback_speed, "warmup_seconds": warmup_seconds, "subemitter_templates": subemitter_templates.size(), "subemitter_emitted": subemitter_emitted, "death_events": death_events, "screen_size_clamped": screen_size_clamped, "screen_size_metric": "max(projected quad width / viewport width, projected quad height / viewport height); Godot compatibility, not recovered Unity raster metric", "subemitter_audits": _subemitter_audits(), "scene_gravity_verified": source_gravity_verified, "unsupported": unsupported.duplicate(), "dropped_at_capacity": dropped_at_capacity, "source_destroyed": source_destroyed, "solver": "Godot compatibility: fixed 1/120 force/gravity/velocity/limit/rotation/plane-collision integration; source curves and module enable flags", "birth_transform_sampling": "source emitter transforms interpolated between seek calls; not native Unity frame scheduling", "renderer_compatibility": "source billboard/horizontal/stretch modes; Godot camera, triangle rasterization, and screen-size clamp are not Unity-native", "rng": "instance-local Godot PCG; not Unity RNG; never game.rng", "native_pixel_equivalence": false}


func _inherit_velocity(p: Dictionary, normalized: float) -> Vector3:
	var inherit: Dictionary = raw.get("InheritVelocityModule", {})
	if not bool(inherit.get("enabled", false)) or int(raw.get("moveWithTransform", 0)) != 1: return Vector3.ZERO
	if int(inherit.get("m_Mode", 0)) != 0: return Vector3.ZERO
	var amount := Curves.minmax(inherit.get("m_Curve", {}), normalized, p.inherit_mix)
	return p.motion_basis.inverse() * p.inherited_velocity * amount

static func _force_step_mix(seed_mix: Vector3, step_index: int) -> Vector3:
	# A stateless per-particle/per-step compatibility sampler. Never consume
	# emission RNG or global/game RNG, so seek granularity and rewind cannot
	# change future births or the reconstructed fixed-step force history.
	var result := Vector3.ZERO
	for axis in range(3):
		var value := (int(seed_mix[axis] * 2147483647.0) + maxi(0, step_index) * 104729 + (axis + 1) * 15485863) & 0x7fffffff
		value = ((value ^ (value >> 16)) * 1103515245 + 12345) & 0x7fffffff
		value = ((value ^ (value >> 13)) * 1103515245 + 12345) & 0x7fffffff
		result[axis] = float(value) / 2147483648.0
	return result

func _acceleration(p: Dictionary, normalized: float, step_index: int = 0) -> Vector3:
	var result := Vector3.ZERO
	var force: Dictionary = raw.get("ForceModule", {})
	if bool(force.get("enabled", false)):
		var mix: Vector3 = _force_step_mix(p.force_mix, step_index) if bool(force.get("randomizePerFrame", false)) else p.force_mix
		result = Vector3(Curves.minmax(force.get("x", {}), normalized, mix.x), Curves.minmax(force.get("y", {}), normalized, mix.y), Curves.minmax(force.get("z", {}), normalized, mix.z))
		if bool(force.get("inWorldSpace", false)): result = p.motion_basis.inverse() * (compatibility_basis * result)
	var gravity := Curves.minmax(raw.get("InitialModule", {}).get("gravityModifier", {}), normalized, p.gravity_mix)
	if absf(gravity) > EPSILON: result += p.motion_basis.inverse() * (compatibility_basis * source_gravity * gravity)
	return result

func _source_node_by_key(parent: Node, key: String) -> Node3D:
	if parent is Node3D and str(parent.get_meta("source_key", "")) == key: return parent
	for child in parent.get_children():
		var found := _source_node_by_key(child, key)
		if found != null: return found
	return null

func _load_collision_planes(spec: Dictionary, assets, parent_root: Node3D) -> void:
	var collision: Dictionary = raw.get("CollisionModule", {})
	if not bool(collision.get("enabled", false)) or int(collision.get("type", 0)) != 0: return
	for index in range(collision.get("m_Planes", []).size()):
		var ref: Dictionary = collision.m_Planes[index]
		if int(ref.get("m_PathID", 0)) == 0:
			null_collision_planes += 1
			continue
		var key: String = spec.system.get("refs", {}).get(".CollisionModule.m_Planes[%d]" % index, "")
		var tr: Dictionary = assets.objects.get(key, {})
		var go: String = tr.get("refs", {}).get(".m_GameObject", "")
		var plane_node := _source_node_by_key(parent_root, go)
		if plane_node == null: _unsupported("missing collision plane transform " + key)
		else: collision_planes.append(plane_node)
	if not collision_planes.is_empty(): compatibility_notes.append("source plane transforms and collision curves; native contact/radius solver replaced by deterministic sphere-plane projection")

func _resolve_collisions(p: Dictionary, previous: Dictionary, next: Dictionary, normalized: float) -> Dictionary:
	if collision_planes.is_empty(): return next
	var collision: Dictionary = raw.get("CollisionModule", {})
	var world_space := int(raw.get("moveWithTransform", 0)) == 1
	var frame := _emitter_transform()
	var motion: Basis = p.motion_basis if world_space else _motion_basis(frame, _emitter_scale())
	var origin: Vector3 = p.start if world_space else frame * p.shape_point
	var old_center: Vector3 = origin + motion * previous.position
	var center: Vector3 = origin + motion * next.position
	var velocity: Vector3 = motion * next.velocity
	var size: float = p.size
	if bool(raw.get("SizeModule", {}).get("enabled", false)): size *= Curves.minmax(raw.SizeModule.curve, normalized, p.size_mix)
	var radius := absf(size) * 0.5 * maxf(motion.x.length(), maxf(motion.y.length(), motion.z.length())) * float(collision.get("radiusScale", 1.0))
	for plane_node in collision_planes:
		if not is_instance_valid(plane_node): continue
		var normal: Vector3 = plane_node.global_basis.y.normalized()
		var signed_distance: float = normal.dot(center - plane_node.global_position)
		if signed_distance >= radius or normal.dot(velocity) >= 0.0: continue
		var old_distance: float = normal.dot(old_center - plane_node.global_position)
		if old_distance < -radius and not bool(collision.get("interiorCollisions", true)): continue
		center += normal * (radius - signed_distance)
		var dampen := clampf(Curves.minmax(collision.get("m_Dampen", {}), normalized, p.limit_mix), 0.0, 1.0)
		var bounce := Curves.minmax(collision.get("m_Bounce", {}), normalized, p.limit_mix)
		var normal_velocity := normal * velocity.dot(normal)
		velocity = (velocity - normal_velocity) * (1.0 - dampen) - normal_velocity * bounce
		var loss := clampf(Curves.minmax(collision.get("m_EnergyLossOnCollision", {}), normalized, p.limit_mix), 0.0, 1.0)
		next.collision_loss += loss
		next.kill_age = minf(next.kill_age, float(p.life) * maxf(0.0, 1.0 - float(next.collision_loss)))
		var speed := velocity.length()
		if speed < float(collision.get("minKillSpeed", 0.0)) or speed > float(collision.get("maxKillSpeed", INF)): next.kill_age = float(next.age)
		next.collision_hits += 1
	next.position = motion.inverse() * (center - origin)
	var velocity_delta: Vector3 = motion.inverse() * velocity - next.velocity
	next.velocity += velocity_delta
	next.render_velocity = next.get("render_velocity", next.velocity) + velocity_delta
	return next


func emit_count(count: int, at_seconds: float = -1.0) -> int:
	if source_destroyed or not is_instance_valid(source_node): return 0
	var at := elapsed_seconds if at_seconds < 0.0 else maxf(0.0, at_seconds)
	seek(at)
	var birth := _to_sim_time(at)
	var living := 0
	for p in particles:
		if float(p.birth) <= birth and float(p.birth) + minf(float(p.life), float(p.get("kill_age", INF))) > birth: living += 1
	var available := maxi(0, int(raw.get("InitialModule", {}).get("maxNumParticles", 1000)) - living)
	var requested := maxi(0, count)
	dropped_at_capacity += maxi(0, requested - available)
	var before := emitted_count
	for i in range(mini(requested, available)):
		var prior := particles.size()
		_spawn_particle(birth, _emitter_transform(), _emitter_scale())
		if particles.size() > prior: particles[-1].manual_emit = true
	seek(at)
	return emitted_count - before


func _load_renderer_mesh(spec: Dictionary, assets) -> void:
	if int(source_renderer.get("m_RenderMode", 0)) != 4: return
	renderer_mesh_key = str(spec.renderer.get("refs", {}).get(".m_Mesh", ""))
	source_render_mesh = assets.geometry(renderer_mesh_key)
	if source_render_mesh == null: _unsupported("missing original renderer mesh " + renderer_mesh_key)
	if bool(raw.get("UVModule", {}).get("enabled", false)): _unsupported("mesh renderer with UV animation")

func _mesh_particle_geometry(frame: Transform3D, particle_color: Color, first_vertex: int) -> Dictionary:
	var output: Dictionary = {"vertices": PackedVector3Array(), "normals": PackedVector3Array(), "uvs": PackedVector2Array(), "colors": PackedColorArray(), "indices": PackedInt32Array()}
	if source_render_mesh == null: return output
	for surface in range(source_render_mesh.get_surface_count()):
		var arrays: Array = source_render_mesh.surface_get_arrays(surface)
		var points: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
		var source_normals = arrays[Mesh.ARRAY_NORMAL]
		var source_colors = arrays[Mesh.ARRAY_COLOR]
		var source_uvs = arrays[Mesh.ARRAY_TEX_UV]
		var source_indices = arrays[Mesh.ARRAY_INDEX]
		var base: int = first_vertex + output.vertices.size()
		# The cofactor transform remains defined for a source zero-scale frame.
		# A fully collapsed mesh has zero-area normals; preserve that geometry
		# rather than replacing its original scale or inverting a singular matrix.
		var b: Basis=frame.basis
		var normal_basis: Basis=b.inverse().transposed() if b.determinant()!=0.0 else Basis(b.y.cross(b.z),b.z.cross(b.x),b.x.cross(b.y))
		for index in range(points.size()):
			output.vertices.append(frame * points[index])
			output.normals.append((normal_basis * source_normals[index]).normalized() if source_normals != null and source_normals.size() == points.size() else Vector3.BACK)
			output.uvs.append(source_uvs[index] if source_uvs != null and source_uvs.size() == points.size() else Vector2.ZERO)
			output.colors.append(particle_color * source_colors[index] if source_colors != null and source_colors.size() == points.size() else particle_color)
		if source_indices == null or source_indices.is_empty():
			for index in range(points.size()): output.indices.append(base + index)
		else:
			for index in source_indices: output.indices.append(base + index)
	return output


func _spatial_velocity(p: Dictionary, displacement: Vector3, normalized: float) -> Vector3:
	var module: Dictionary = raw.get("VelocityModule", {})
	if not bool(module.get("enabled", false)): return Vector3.ZERO
	var omega := Vector3(Curves.minmax(module.get("orbitalX", {}), normalized, p.velocity_mix.x), Curves.minmax(module.get("orbitalY", {}), normalized, p.velocity_mix.y), Curves.minmax(module.get("orbitalZ", {}), normalized, p.velocity_mix.z))
	var offset := Vector3(Curves.minmax(module.get("orbitalOffsetX", {}), normalized, p.velocity_mix.x), Curves.minmax(module.get("orbitalOffsetY", {}), normalized, p.velocity_mix.y), Curves.minmax(module.get("orbitalOffsetZ", {}), normalized, p.velocity_mix.z))
	var radial := Curves.minmax(module.get("radial", {}), normalized, p.velocity_mix.x)
	if omega.is_zero_approx() and absf(radial) < EPSILON: return Vector3.ZERO
	var relative: Vector3 = p.shape_point + displacement - offset
	if bool(module.get("inWorldSpace", false)):
		var to_source: Basis = compatibility_basis.inverse() * p.motion_basis
		var source_relative: Vector3 = to_source * (p.shape_point + displacement) - offset
		return to_source.inverse() * (omega.cross(source_relative) + source_relative.normalized() * radial)
	return omega.cross(relative) + relative.normalized() * radial

func _from_sim_time(seconds: float) -> float:
	for index in range(speed_segments.size() - 1, -1, -1):
		var segment: Dictionary = speed_segments[index]
		if seconds >= float(segment.sim) and float(segment.speed) > 0.0: return float(segment.at) + (seconds - float(segment.sim)) / float(segment.speed)
	return 0.0

func _load_subemitters(spec: Dictionary) -> void:
	var module: Dictionary = raw.get("SubModule", {})
	if not bool(module.get("enabled", false)): return
	for index in range(module.get("subEmitters", []).size()):
		var item: Dictionary = module.subEmitters[index]
		if int(item.get("emitter", {}).get("m_PathID", 0)) == 0: continue
		if int(item.get("type", 0)) not in [0, 2] or int(item.get("properties", 0)) != 0: continue
		var event_type := int(item.get("type", 0))
		var key: String = spec.system.get("refs", {}).get(".SubModule.subEmitters[%d].emitter" % index, "")
		if subemitter_ancestry.has(key): _unsupported("cyclic SubModule reference " + key); continue
		var system: Dictionary = source_assets.objects.get(key, {})
		if system.get("type", "") != "ParticleSystem": _unsupported("missing SubModule ParticleSystem " + key); continue
		var go: String = system.get("refs", {}).get(".m_GameObject", "")
		var node := _source_node_by_key(source_scope_root, go)
		if node == null: _unsupported("missing SubModule source node " + go); continue
		var emission: Dictionary = system.data.get("EmissionModule", {})
		if event_type == 0 and (int(emission.get("rateOverTime", {}).get("minMaxState", 0)) != 0 or not emission.get("m_Bursts", []).is_empty()):
			_unsupported("SubModule Birth nonconstant rate or burst " + key); continue
		if event_type == 2:
			# Source A/B/C (including B's second Death stage) have exactly one
			# immediate burst. Do not pretend delayed/repeating bursts are solved.
			var bursts: Array = emission.get("m_Bursts", [])
			if bursts.size() > 1 or (not bursts.is_empty() and (float(bursts[0].get("time", 0.0)) != 0.0 or int(bursts[0].get("cycleCount", 1)) != 1)) or _curve_nonzero(system.data.get("startDelay", {})):
				_unsupported("SubModule Death non-immediate/single burst " + key); continue
		var solver = get_script().new()
		var sub_spec: Dictionary = {"system": system, "renderer": source_assets.component(go, "ParticleSystemRenderer"), "node": node, "autoplay": false, "compatibility_basis": compatibility_basis, "source_scope_root": source_scope_root, "subemitter_ancestry": subemitter_ancestry}
		solver.setup(sub_spec, source_assets, self, instance_seed + 104729 * (index + 1))
		var rate := maxf(0.0, Curves.minmax(emission.get("rateOverTime", {}), 0.0)) if bool(emission.get("enabled", false)) else 0.0
		subemitter_templates.append({"solver": solver, "source_key": key, "rate": rate, "probability": float(item.get("emitProbability", 1.0)), "type": event_type})
		if event_type == 0:
			compatibility_notes.append("Birth subemitter " + key + " follows parent particle lifetime at original constant rate; exact native frame/RNG schedule is not recovered")
		else:
			compatibility_notes.append("Death subemitter " + key + " triggers its source immediate burst once at parent expiry; properties=None; original loop flag does not autonomously replay event bursts; native frame/RNG schedule is not recovered")

func _update_subemitters(now: float) -> void:
	if subemitter_templates.is_empty(): return
	var events: Array = []
	for parent in particles:
		var until := minf(now - float(parent.birth), float(parent.life))
		if until < 0.0: continue
		# Resolve parent collisions before deciding which lifetime events exist.
		# A live collisionless parent cannot expire early. Do not integrate it
		# to the frame end before its Birth events: that forces _position() to
		# rewind and replay its entire history for an earlier event. Rendering
		# below advances it to now once after the ordered event positions.
		var final_state: Dictionary = {"kill_age": parent.get("kill_age", INF)}
		if until >= float(parent.life) or bool(raw.get("CollisionModule", {}).get("enabled", false)):
			final_state = _particle_state(parent, until)
		until = minf(until, float(final_state.get("kill_age", INF)))
		for index in range(subemitter_templates.size()):
			var template: Dictionary = subemitter_templates[index]
			if int(template.type) == 2:
				var death_age := minf(float(parent.life), float(final_state.get("kill_age", INF)))
				if int(parent.sub_cursors[index]) == 1 and now + EPSILON >= float(parent.birth) + death_age:
					parent.sub_cursors[index] = 0 # Consume once, including probability rejection.
					var probability := clampf(float(template.probability), 0.0, 1.0)
					if probability > 0.0 and death_rng.randf() < probability:
						events.append({"at": float(parent.birth) + death_age, "age": death_age, "parent": parent, "template": template})
				continue
			if not bool(parent.sub_probabilities[index]) or float(template.rate) <= 0.0: continue
			var delay: float = template.solver.start_delay
			while delay + float(parent.sub_cursors[index]) / float(template.rate) <= until + EPSILON:
				var age := delay + float(parent.sub_cursors[index]) / float(template.rate)
				events.append({"at": float(parent.birth) + age, "age": age, "parent": parent, "template": template})
				parent.sub_cursors[index] += 1
	events.sort_custom(func(a, b): return float(a.at) < float(b.at))
	for event in events:
		var position := _position(event.parent, float(event.age))
		var wall := _from_sim_time(float(event.at))
		if int(event.template.type) == 2:
			death_events += 1
			subemitter_emitted += int(event.template.solver.emit_death_from_parent(position, wall))
		else:
			subemitter_emitted += int(event.template.solver.emit_from_parent(position, wall))
	for template in subemitter_templates: template.solver.seek(elapsed_seconds)

func emit_death_from_parent(position: Vector3, wall_seconds: float) -> int:
	# Event-only subemitters never Play(): the serialized loop flag must not
	# create autonomous bursts. Child curves, shape, capacity and recursively
	# configured subemitters still run in their own solver/source scope.
	if source_destroyed or not is_instance_valid(source_node): return 0
	var emission: Dictionary = raw.get("EmissionModule", {})
	if not bool(emission.get("enabled", false)): return 0
	var count := 0
	for burst in emission.get("m_Bursts", []):
		var probability := clampf(float(burst.get("probability", 1.0)), 0.0, 1.0)
		if probability <= 0.0 or death_rng.randf() >= probability: continue
		var requested := maxi(0, int(Curves.minmax(burst.get("countCurve", {}), 0.0, death_rng.randf())))
		count += emit_from_parent(position, wall_seconds, requested)
	return count

func emit_from_parent(position: Vector3, wall_seconds: float, count: int = 1) -> int:
	if source_destroyed or not is_instance_valid(source_node): return 0
	var at := _to_sim_time(wall_seconds)
	var living := 0
	for p in particles:
		if float(p.birth) <= at and float(p.birth) + minf(float(p.life), float(p.get("kill_age", INF))) > at: living += 1
	var maximum := int(raw.get("InitialModule", {}).get("maxNumParticles", 1000))
	var source_frame := _emitter_transform()
	var emission_frame := source_frame
	emission_frame.origin = position
	var emitted := 0
	# A burst is synchronous: count existing live particles once, then update
	# the count only after successful spawns. This retains capacity, zero-life
	# attempts and every RNG draw in the original per-particle order.
	for index in range(maxi(0, count)):
		if living >= maximum:
			dropped_at_capacity += count - index
			break
		var before := particles.size()
		_spawn_particle(at, emission_frame, _emitter_scale())
		if particles.size() == before: continue
		var p: Dictionary = particles[-1]
		p.manual_emit = true
		if int(raw.get("moveWithTransform", 0)) != 1: p.shape_point = source_frame.affine_inverse() * p.start
		living += 1
		emitted += 1
	return emitted

func _subemitter_audits() -> Array:
	var result: Array = []
	for template in subemitter_templates: result.append(template.solver.get_audit())
	return result
