extends SceneTree
class Host extends Node:
 var board_render_target_size=Vector2i(2560,1152)
 var presentation_size=Vector2(2000,900)
 var world_canvas=Node2D.new()
func _initialize():call_deferred("run")
func run():
 var host=Host.new();root.add_child(host);host.add_child(host.world_canvas)
 var presentation=load("res://scripts/native_coin_presentation.gd").new();host.add_child(presentation);presentation.setup(host)
 assert(presentation.viewport.size==host.board_render_target_size)
 assert(presentation.sprite.scale.is_equal_approx(host.presentation_size/Vector2(host.board_render_target_size)))
 assert(presentation.sprite.position==Vector2(800,450))
 assert(not presentation.sprite.visible)
 presentation.set_active(true);assert(presentation.sprite.visible)
 assert(presentation.background_copy.visible and presentation.background_copy.z_index==presentation.sprite.z_index)
 assert(presentation.sprite.get_index()>presentation.background_copy.get_index())
 assert(presentation.sprite.modulate.a==2.0)
 assert(presentation.sprite.material.shader==preload("res://shaders/native_combat_transmission_composite.gdshader"))
 presentation.sync_composite()
 assert(presentation.transmission.transmission_view.size==presentation.viewport.size)
 assert(presentation.transmission.camera.global_transform.is_equal_approx(presentation.camera.global_transform))
 assert(presentation.transmission.mirrors.size()>0)
 assert(presentation.sprite.material.get_shader_parameter("transmission_texture")==presentation.transmission.get_texture())
 presentation.set_active(false)
 assert(presentation.transmission.transmission_view.render_target_update_mode==SubViewport.UPDATE_DISABLED)
 assert(not presentation.background_copy.visible)
 presentation.set_active(true)
 var world=Vector3(-3.443410158,0.182749748,-4.99461031)
 var source=presentation.source_reflection*world
 var projected=presentation.camera.unproject_position(source)
 assert(is_finite(projected.x) and is_finite(projected.y))
 print("COIN_PRESENTATION_PASS projected source bone=",projected," source-camera clone; no GPU comparison")
 host.queue_free();quit()
