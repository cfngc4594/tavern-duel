extends SceneTree
const SourceProjection=preload("res://scripts/source_board_projection.gd")
const Policy=preload("res://scripts/source_board_camera_policy.gd")
func _initialize():call_deferred("run")
func run():
 var config=JSON.parse_string(FileAccess.get_file_as_string("res://original_board/references/minimum_scene_config.json"))
 var owner=Node.new();root.add_child(owner)
 var vp=SubViewport.new();owner.add_child(vp)
 var camera_root=Node3D.new();vp.add_child(camera_root)
 var camera=Camera3D.new();camera_root.add_child(camera)
 for canvas in [Vector2(1600,900),Vector2(2000,900),Vector2(1600,1200)]:
  vp.size=Vector2i(canvas);Policy.apply(camera,camera_root,config,canvas,true)
  var p=Vector3(-7.8,-0.04758995771408081,-5.6)
  var anchors={"play:0":{"position":p,"rotation":Quaternion.IDENTITY,"scale":Vector3.ONE,"verified":true,"source":"synthetic plane test, not source scale evidence"}}
  var context=SourceProjection.install(owner,camera,Vector2(vp.size),canvas,(canvas-Vector2(1600,900))*.5,anchors)
  assert(context!=null and context.is_enabled() and SourceProjection.from_game(owner)==context)
  assert(SourceProjection.render_to_source(SourceProjection.source_to_render(p)).is_equal_approx(p))
  var screen=context.source_to_screen(p)
  var hit=context.screen_to_source_on_plane(screen,Plane(Vector3.UP,p.y))
  assert(not hit.is_empty() and hit.position.distance_to(p)<0.0001)
  assert(context.resolve_anchor("play:0").position==p)
  assert(context.resolve_anchor({"type":"unit","unit":{"source_world_position":p}}).position==p)
  assert(context.unit_target({"source_world_target":p}).position==p)
  assert(context.resolve_anchor({"pos":Vector2(800,450)}).is_empty())
  assert(context.resolve_anchor("missing").is_empty())
  assert(context.unit_target({"target":Vector2(800,450)}).is_empty())
  var other=Camera3D.new();vp.add_child(other);assert(context.copy_camera(other))
  assert(other.global_transform.is_equal_approx(camera.global_transform))
  assert(other.fov==camera.fov and other.projection==camera.projection)
  other.queue_free()
  SourceProjection.unregister(owner);assert(SourceProjection.from_game(owner)==null)
 Policy.apply(camera,camera_root,config,Vector2(1600,900),false)
 assert(SourceProjection.install(owner,camera,Vector2(vp.size),Vector2(vp.size),Vector2.ZERO,{})==null)
 print("SOURCE_BOARD_PROJECTION_PASS round trip three aspects, explicit plane, missing anchors rejected, phone camera copied, desktop rejected")
 owner.queue_free();quit()
