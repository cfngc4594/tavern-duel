extends SceneTree
func _initialize():call_deferred("run")
func run():
 var rotator=load("res://scripts/native_drag_rotator.gd").new()
 assert(rotator.info.m_PitchInfo.m_ForceMultiplier==25.0)
 assert(rotator.info.m_PitchInfo.m_RestSeconds==2.0)
 rotator.reset(Vector3.ZERO)
 assert(rotator.sample(Vector3(1,0,1),0.0)==Vector2(25,-25))
 rotator.reset(Vector3.ZERO)
 assert(rotator.sample(Vector3(100,0,100),0.0)==Vector2(40,-45))
 rotator.reset(Vector3.ZERO)
 assert(rotator.sample(Vector3(-100,0,-100),0.0)==Vector2(-40,45))
 rotator.reset(Vector3.ZERO)
 assert(rotator.sample(Vector3(0.001,0,0.001),0.016)==Vector2.ZERO)
 rotator.reset(Vector3.ZERO)
 var step=rotator.sample(Vector3(1,0,1),1.0/60.0)
 assert(is_equal_approx(step.x,24.694870) and is_equal_approx(step.y,-24.694870))
 var first=step
 for i in range(120):step=rotator.sample(Vector3(1,0,1),1.0/60.0)
 assert(absf(step.x)<0.00001 and absf(step.y)<0.00001)
 rotator.reset(Vector3(1,2,3))
 assert(rotator.pitch_velocity==0 and rotator.roll_velocity==0 and rotator.pitch==0 and rotator.roll==0)
 var scene=load("res://scripts/classic_spatial.gd").new()
 var projection=scene._drag_source_basis()*scene.DRAG_SOURCE_PROJECTION_SCALE
 var source=Vector3(1,2,3)
 assert((projection.inverse()*(projection*source)).is_equal_approx(source))
 scene.free()
 print("DRAG_ROTATOR_PASS serialized params; world delta/sign; min/max; tiny-motion gate; SmoothDamp=",first,"; no-motion decay; reset; compatibility basis inversion")
 quit()
