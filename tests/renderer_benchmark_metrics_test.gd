extends SceneTree
const Metrics=preload("res://tests/renderer_benchmark_metrics.gd")
func _initialize():
 var raw: Array = [4.0,1.0,3.0,2.0]
 var summary := Metrics.stats(raw)
 assert(raw==[4.0,1.0,3.0,2.0])
 assert(summary.mean==2.5 and summary.p50==3.0 and summary.p95==4.0 and summary.p99==4.0 and summary.max==4.0)
 assert(Metrics.stats([]).count==0)
 assert(Metrics.stats([0.0,0.0],"unavailable").available==false)
 assert(not Metrics.stats([0.0,0.0],"unavailable").has("mean"))
 assert(Metrics.stats([0.0,1.0],"unavailable").available)
 assert(not Metrics.stats([INF]).available and not Metrics.stats([-1.0]).available)
 var headless := Metrics.rendering_capabilities("headless","gl_compatibility","")
 assert(not headless.rendering_active and headless.measurement_scope=="headless_logic_only")
 assert(not Metrics.rendering_capabilities("X11","gl_compatibility","RTX").rendering_device_counters)
 assert(Metrics.rendering_capabilities("X11","forward_plus","RTX").rendering_device_counters)
 assert(Metrics.rendering_capabilities("X11","forward_plus","llvmpipe").software_renderer)
 var metrics=Metrics.new()
 metrics.configure_pipelines(true,headless)
 assert(not metrics.pipeline_status.available and metrics.pipeline_snapshot().is_empty())
 metrics.configure_pipelines(false,headless)
 assert(metrics.pipeline_status.reason=="not_requested")
 assert(Metrics.counter_delta({"draw":4},{"draw":7})=={"draw":3})
 assert(Metrics.counter_delta({"draw":4},{"draw":1,"new":2})=={"draw":null,"new":null})
 print("RENDERER_BENCHMARK_METRICS_PASS")
 quit()
